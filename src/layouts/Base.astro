---
import '../styles/global.css';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { url } from '../lib/urls.mjs';
import { publishedRecipes } from '../lib/content.mjs';
interface Props { title: string; active?: string; description?: string; crumbs?: { label: string; href?: string }[] }
const { title, active, crumbs, description = 'Personal cookbook: recipes, this week’s meals and the shopping list.' } = Astro.props;
const recipes = publishedRecipes();
const nav = [
  ['recipes', 'Recipes', '', `${recipes.length}`],
  ['week', 'This week', 'week/', ''],
  ['shopping', 'Shopping', 'shopping/', ''],
  ['pantry', 'Pantry', 'pantry/', ''],
  ['history', 'History', 'history/', ''],
  ['reference', 'Reference', 'reference/', ''],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content={description}>
  <title>{title === 'Recipes' ? 'Cookbook' : `${title} · Cookbook`}</title>
  <link rel="icon" href={url('favicon.svg')} type="image/svg+xml">
  <script is:inline>try{var t=localStorage.getItem('cookbook:theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t}catch(e){}</script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header><div class="top"><a class="brand" href={url()}><span aria-hidden="true">c.</span>cookbook</a><div class="top-end"><small>Your recipes. Ready to cook.</small><button class="theme" type="button" id="theme" hidden>Theme</button></div></div></header>
  <div class="layout">
    <aside>
      <div class="eyebrow">At your table</div>
      <nav class="nav" aria-label="Cookbook">
        {nav.map(([key, label, path, count]) => (
          <a href={url(path)} class={active === key ? 'active' : undefined} aria-current={active === key ? 'page' : undefined}>{label} {count && <span>{count}</span>}</a>
        ))}
      </nav>
      <div class="actions">
        <a class="btn" href={url('edit/')}>Family editor</a>
        <a class="btn" href="https://github.com/baky0905/cookbook" target="_blank" rel="noopener noreferrer" aria-label="GitHub source (opens in a new tab)">GitHub source ↗</a>
      </div>
      <p class="side-note">Choose meals together.<br>Make room for something delicious.</p>
    </aside>
    <main id="main">
      {crumbs && <Breadcrumbs items={crumbs} />}
      <slot />
    </main>
  </div>
  <script>
    // Theme: follow the device, or a choice saved on this device.
    const button = document.getElementById('theme')!;
    const modes = ['auto', 'light', 'dark'] as const;
    const label = { auto: '◐ Auto', light: '☀ Light', dark: '☾ Dark' };
    let mode: typeof modes[number] = (document.documentElement.dataset.theme as any) || 'auto';
    const show = () => { button.textContent = label[mode]; button.setAttribute('aria-label', `Colour theme: ${mode}. Change`); };
    button.addEventListener('click', () => {
      mode = modes[(modes.indexOf(mode) + 1) % modes.length];
      if (mode === 'auto') delete document.documentElement.dataset.theme; else document.documentElement.dataset.theme = mode;
      try { mode === 'auto' ? localStorage.removeItem('cookbook:theme') : localStorage.setItem('cookbook:theme', mode); } catch {}
      show();
    });
    show();
    button.hidden = false;
  </script>
</body>
</html>
