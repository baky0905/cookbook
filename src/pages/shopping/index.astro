---
import Base from '../../layouts/Base.astro';
import WeekPicker from '../../components/WeekPicker.astro';
import ShoppingPlan from '../../components/ShoppingPlan.astro';
import { readPlans, currentPlan } from '../../lib/content.mjs';
const plans = readPlans();
const current = currentPlan(plans);
---
<Base title="Shopping" active="shopping" crumbs={[{ label: 'Shopping' }]}>
  <h1>Shopping</h1>
  <WeekPicker plans={plans} />
  {[null, ...plans].map(plan => <div data-plan-view={plan?.id || ''} hidden={(plan?.id || '') !== (current?.id || '')}><ShoppingPlan plan={plan} /></div>)}
</Base>
