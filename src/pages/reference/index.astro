---
import Base from '../../layouts/Base.astro';
import { referencePagesList } from '../../lib/reference.mjs';
import { url } from '../../lib/urls.mjs';
---
<Base title="Reference" active="reference" crumbs={[{ label: 'Reference' }]}>
  <h1>Reference</h1>
  <p class="subtitle">Quick answers while you cook.</p>
  <ul class="results">
    {referencePagesList.map(([slug, title, about]) => <li><a href={url(`reference/${slug}/`)}><span><span class="name">{title}</span><span class="info">{about}</span></span></a></li>)}
  </ul>
</Base>
