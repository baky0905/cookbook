---
import Base from '../../layouts/Base.astro';
import { readPantry } from '../../lib/content.mjs';
import { number } from '../../lib/quantities.mjs';
const pantry = readPantry();
const items = [...pantry.items].sort((a, b) => a.name.localeCompare(b.name));
---
<Base title="Pantry" active="pantry">
  <h1>Pantry</h1>
  <p class="subtitle">A published snapshot{pantry.updated ? `, updated ${pantry.updated}` : ''}. It is not live stock tracking.</p>
  {items.length === 0
    ? <p class="empty">No pantry items recorded yet. Add them to <code>content/pantry.yaml</code>.</p>
    : <div class="table-wrap"><table>
        <thead><tr><th scope="col">Ingredient</th><th scope="col">Quantity</th><th scope="col">Note</th></tr></thead>
        <tbody>{items.map(i => <tr><td>{i.name}</td><td>{i.quantity != null ? `${number(i.quantity)} ${i.unit ?? ''}` : '–'}</td><td>{i.stocked ? 'Usually stocked' : ''}</td></tr>)}</tbody>
      </table></div>}
</Base>
