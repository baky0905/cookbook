---
import Base from '../../layouts/Base.astro';
import WeekPicker from '../../components/WeekPicker.astro';
import WeekPlan from '../../components/WeekPlan.astro';
import { readPlans, currentPlan } from '../../lib/content.mjs';
const plans = readPlans();
const current = currentPlan(plans);
---
<Base title="This week" active="week" crumbs={[{ label: 'This week' }]}>
  <h1>This week</h1>
  <WeekPicker plans={plans} />
  {[null, ...plans].map(plan => <div data-plan-view={plan?.id || ''} hidden={(plan?.id || '') !== (current?.id || '')}><WeekPlan plan={plan} /></div>)}
</Base>
