---
import crypto from 'node:crypto';
import Base from '../../layouts/Base.astro';
import { publishedRecipes, readPlans, currentPlan, readCatalog } from '../../lib/content.mjs';
import { estimateCalories } from '../../lib/nutrition.mjs';
import { amount } from '../../lib/quantities.mjs';
import { stepHtml, quantityAttrs, markdown, escape, prepHtml } from '../../lib/render.mjs';
import { picture } from '../../lib/media.mjs';
import { url } from '../../lib/urls.mjs';

export function getStaticPaths() {
  return publishedRecipes().map(recipe => ({ params: { id: recipe.id }, props: { recipe } }));
}
const { recipe } = Astro.props;
const r = recipe.data;
const items = r.groups.flatMap(g => g.items);
// Progress is stored per device; changing ingredients or steps invalidates it.
const version = crypto.createHash('sha256').update(JSON.stringify([r.groups, r.steps])).digest('hex').slice(0, 10);
const cover = r.cover ? await picture(r.cover.src, 480) : null;
const steps = await Promise.all(r.steps.map(async step => ({
  ...step,
  html: stepHtml(step.text, items),
  photos: await Promise.all(step.images.map(async image => ({ ...image, ...(await picture(image.src, 440)) }))),
})));
const hasPhotos = steps.some(s => s.photos.length);
const times = [['total', 'Total'], ['active', 'Active'], ['cook', 'Cook'], ['rest', 'Rest']].filter(([k]) => r.time[k]);
const statusLabel = { draft: 'Draft', 'needs-review': 'Needs review', reviewed: 'Checked against source', cooked: 'Cooked & tested' }[r.status];
const archive = r.legacyPath ? url(`archive/${r.legacyPath.replace(/\/$/, '')}.md`) : null;
const hostname = (u: string) => new URL(u).hostname.replace(/^www\./, '');
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// Calories: an entered value wins; otherwise a catalogue estimate, shown only when it covers most of the recipe.
const estimate = estimateCalories(r, readCatalog());
const kcal = r.nutrition?.kcalPerPortion
  ? { text: `${r.nutrition.kcalPerPortion} kcal per portion`, title: r.nutrition.source ? `Source: ${r.nutrition.source}` : 'Entered value' }
  : estimate.reliable && (estimate.perPortion || estimate.kcal)
    ? { text: estimate.perPortion ? `≈ ${estimate.perPortion} kcal per portion` : `≈ ${estimate.kcal} kcal in total`,
        title: `Estimate from reference values${estimate.uncounted.length ? `; not counted: ${estimate.uncounted.join(', ')}` : ''}` }
    : null;
// This week's plan: show when it's planned and open the scaler at the planned amount.
const plan = currentPlan(readPlans());
const planned = (plan?.meals || []).filter(m => m.recipe === recipe.id && !m.leftoversFrom);
const day = (d: string) => new Date(d + 'T12:00:00Z').toLocaleDateString('en-GB', { weekday: 'long', timeZone: 'UTC' });
// Portions when the yield is exact, otherwise whole batches.
const portionStep = r.yield.amount ? (r.yield.amount <= 12 ? 1 : r.yield.amount / 4) : null;
---
<Base title={r.title} active="recipes" description={r.description || `${r.title} recipe`} crumbs={[{ label: r.category, href: `?category=${encodeURIComponent(r.category)}` }, { label: r.title }]}>
  <article id="recipe" data-recipe={recipe.id} data-version={version} data-yield={r.yield.amount} data-yield-unit={r.yield.unit} data-step={portionStep}>
    <div class="title-row">
      <div>
        <h1>{r.title}</h1>
        {r.description && <p class="subtitle">{r.description}</p>}
      </div>
      {cover && (
        <button class="cover" type="button" data-full={cover.full} data-caption={r.cover!.caption || r.cover!.alt} aria-label={`Enlarge photo: ${r.cover!.alt}`}>
          <img src={cover.src} width={cover.width} height={cover.height} alt={r.cover!.alt}>
        </button>
      )}
    </div>
    <div class="meta">
      {times.map(([k, label]) => <span>{label} <strong>{r.time[k]}</strong></span>)}
      <span><strong id="yield-label">{r.yield.label}</strong></span>
      {kcal && <span title={kcal.title}><strong>{kcal.text}</strong></span>}
      <span class={`status ${r.status}`}>{statusLabel}</span>
    </div>
    {planned.length > 0 && (
      <p class="notice planned">{planned.map(m => <span>Planned for {day(m.date)} {m.meal.toLowerCase()}{m.servings ? ` · ${m.servings} ${r.yield.unit}` : m.batches && m.batches !== 1 ? ` · ×${m.batches}` : ''}{m.note && ` · ${m.note}`} </span>)}</p>
    )}
    {r.tags.length > 0 && <nav class="tags" aria-label="Tags">{r.tags.map(t => <a href={url(`?tag=${encodeURIComponent(t)}`)}>{t}</a>)}</nav>}

    <div class="actions" hidden data-js>
      <button class="btn primary" type="button" id="cook" aria-pressed="false">Cooking view</button>
      <button class="btn" type="button" id="print">Print recipe</button>
      {hasPhotos && <label class="toggle"><input type="checkbox" id="print-photos"> Include step photos when printing</label>}
      <div class="servings" role="group" aria-label={r.yield.amount ? 'Portions' : 'Batch size'}>
        <button type="button" data-step="-1" aria-label={r.yield.amount ? 'Fewer' : 'Smaller batch'}>−</button>
        <output id="servings" aria-live="polite" data-planned-servings={planned[0]?.servings} data-planned-batches={planned[0]?.batches}>{r.yield.amount ? `${r.yield.amount} ${r.yield.unit}` : 'Original batch'}</output>
        <button type="button" data-step="1" aria-label={r.yield.amount ? 'More' : 'Larger batch'}>+</button>
      </div>
      <button class="reset scale-reset" type="button" id="scale-reset" hidden>Back to original</button>
    </div>

    <div class="recipe">
      <section class="ingredients" id="ingredients" aria-labelledby="ingredients-title">
        <h2 id="ingredients-title">Ingredients</h2>
        <p class="caption">Tick off as you prepare <a class="jump" href="#method">Method ↓</a></p>
        <p class="caption scale-note" id="scale-note" hidden>Scaled from the original ({r.yield.label}).{!r.yield.scalable && ' Pan size and baking or cooking times may need adjusting.'}</p>
        {r.groups.map(group => (
          <>
            {(r.groups.length > 1 || group.name !== 'Ingredients') && <h3>{group.name}</h3>}
            {group.items.map(item => (
              <label class="ingredient">
                <input type="checkbox" data-check={`i:${item.id}`}>
                <span set:html={`${item.quantity != null ? `<b class="qty"${quantityAttrs(item)}>${amount(item)}</b> ` : ''}${escape(item.name)}${item.prep ? `, <span class="prep">${prepHtml(item.prep[0].toLowerCase() + item.prep.slice(1), base)}</span>` : ''}${item.optional ? ' <small>Optional</small>' : ''}${item.note ? `<small>${escape(item.note)}</small>` : ''}${item.quantity == null && !item.note ? '<small>Amount not specified</small>' : ''}`} />
              </label>
            ))}
          </>
        ))}
        {r.issues.length > 0 && (
          <div class="review" role="note"><strong>Before cooking</strong>
            <ul>{r.issues.map(issue => <li>{issue}</li>)}</ul>
          </div>
        )}
        <button class="reset" type="button" id="reset" hidden data-js>Clear ticks</button>
      </section>

      <section id="method" aria-labelledby="method-title">
        <h2 id="method-title">Method</h2>
        <p class="caption">Everything in the order you need it <a class="jump" href="#ingredients">Ingredients ↑</a></p>
        <ol class="steps">
          {steps.map(step => (
            <li id={step.id}>
              <div class="step-head">
                <div>
                  {(step.title || step.duration) && <h3>{step.title}{step.duration && <span class="time">{step.duration}</span>}</h3>}
                  <div class="step-text" set:html={step.html} />
                </div>
                <input class="step-check" type="checkbox" data-check={`s:${step.id}`} aria-label={`Mark step done`}>
              </div>
              {step.photos.length > 0 && (
                <ul class="photos">
                  {step.photos.map(photo => (
                    <li><figure>
                      <button type="button" data-full={photo.full} data-caption={photo.caption || photo.alt} aria-label={`Enlarge photo: ${photo.alt}`}>
                        <img src={photo.src} width={photo.width} height={photo.height} alt={photo.alt} loading="lazy" decoding="async">
                      </button>
                      {(photo.caption || photo.credit) && <figcaption>{photo.caption}{photo.credit && <> · {photo.credit}</>}</figcaption>}
                    </figure></li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ol>
      </section>
    </div>

    {r.sources.length > 0 && (
      <div class="source">
        {r.sources.map(source => source.url
          ? <a href={source.url + (source.timestamp && source.url.includes('youtube.com') ? `&t=${source.timestamp}` : '')} rel="noopener">{source.title === 'Original Recipe Source' || source.title === 'Saved video' ? `${source.title} · ${hostname(source.url)}` : source.title} ↗</a>
          : <span>{source.title}</span>)}
      </div>
    )}
    {recipe.body && <section class="notes"><h2>Notes</h2><div class="prose" set:html={markdown(recipe.body)} /></section>}
    {(r.adaptations.length > 0 || archive) && (
      <details>
        <summary>Provenance</summary>
        <ul>{r.adaptations.map(a => <li>{a}</li>)}</ul>
        {r.originalLanguage && <p>Original language: {new Intl.DisplayNames(['en'], { type: 'language' }).of(r.originalLanguage)}.</p>}
        {r.sources.some(s => s.accessed) && <p>Sources accessed: {r.sources.filter(s => s.accessed).map(s => `${s.title} (${s.accessed})`).join(', ')}</p>}
        {archive && <p><a href={archive}>Original saved version</a></p>}
      </details>
    )}
  </article>
  <dialog class="lightbox" aria-label="Enlarged photo">
    <button class="close" type="button">Close ✕</button>
    <img alt="">
    <p></p>
  </dialog>
</Base>

<script>
  import { formatAmount } from '../../lib/format.mjs';
  const article = document.getElementById('recipe')!;
  const key = `cookbook:recipe:${article.dataset.recipe}:${article.dataset.version}`;
  const store = {
    get() { try { return JSON.parse(localStorage.getItem(key) || '{}'); } catch { return {}; } },
    set(value: object) { try { localStorage.setItem(key, JSON.stringify(value)); } catch {} },
  };
  document.querySelectorAll<HTMLElement>('[data-js]').forEach(el => (el.hidden = false));

  // Ticks
  const state = store.get();
  const boxes = [...document.querySelectorAll<HTMLInputElement>('[data-check]')];
  for (const box of boxes) {
    box.checked = !!state.checked?.[box.dataset.check!];
    box.addEventListener('change', () => {
      const s = store.get(); s.checked = { ...s.checked, [box.dataset.check!]: box.checked }; store.set(s);
    });
  }
  document.getElementById('reset')!.addEventListener('click', () => {
    boxes.forEach(b => (b.checked = false));
    const s = store.get(); delete s.checked; store.set(s);
  });

  // Scaling: by portions when the yield is exact, otherwise by batch; always from the original amounts.
  const base = Number(article.dataset.yield) || 0;
  const step = Number(article.dataset.step) || 0;
  const unit = article.dataset.yieldUnit;
  const output = document.getElementById('servings')!;
  const yieldLabelEl = document.getElementById('yield-label')!;
  const yieldLabel = yieldLabelEl.textContent;
  const batches = [0.25, 0.5, 1, 1.5, 2, 3, 4];
  const params = new URLSearchParams(location.search);
  let factor = 1;
  function apply(f: number, save = true) {
    factor = f;
    const scaled = f !== 1;
    output.textContent = base ? `${+(base * f).toFixed(2)} ${unit}` : scaled ? `×${f} batch` : 'Original batch';
    yieldLabelEl.textContent = scaled ? `${base ? `${+(base * f).toFixed(2)} ${unit}` : `×${f}`} (scaled from ${yieldLabel})` : yieldLabel;
    document.getElementById('scale-note')!.hidden = !scaled;
    document.getElementById('scale-reset')!.hidden = !scaled;
    document.querySelectorAll<HTMLElement>('[data-qty]').forEach(el => {
      const target = el.matches('.ref') ? el.querySelector('.qty')! : el;
      target.textContent = formatAmount(el.dataset, f);
    });
    if (save) { const s = store.get(); s.factor = f; store.set(s); }
  }
  const planned = base && output.dataset.plannedServings ? Number(output.dataset.plannedServings) / base : Number(output.dataset.plannedBatches) || 0;
  const fromUrl = base && params.get('servings') ? Number(params.get('servings')) / base : Number(params.get('batch')) || 0;
  apply(fromUrl || state.factor || planned || 1, false);
  document.querySelectorAll<HTMLButtonElement>('.servings button').forEach(button => button.addEventListener('click', () => {
    const dir = Number(button.dataset.step);
    if (base) apply(Math.max(step, base * factor + dir * step) / base);
    else { const i = batches.findIndex(b => b >= factor - 1e-9); apply(batches[Math.min(batches.length - 1, Math.max(0, (i < 0 ? batches.length - 1 : i) + dir))]); }
  }));
  document.getElementById('scale-reset')!.addEventListener('click', () => apply(1));

  // Cooking view and printing
  const cook = document.getElementById('cook')!;
  const setCooking = (on: boolean) => {
    document.body.classList.toggle('cooking', on);
    cook.setAttribute('aria-pressed', String(on));
    cook.textContent = on ? 'Exit cooking view' : 'Cooking view';
  };
  cook.addEventListener('click', () => setCooking(!document.body.classList.contains('cooking')));
  if (location.hash === '#cook') setCooking(true);
  const photos = document.getElementById('print-photos') as HTMLInputElement | null;
  photos?.addEventListener('change', () => document.body.classList.toggle('print-photos', photos.checked));
  document.getElementById('print')!.addEventListener('click', () => window.print());

  // Lightbox
  const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox')!;
  const big = dialog.querySelector('img')!;
  let opener: HTMLElement | null = null;
  document.querySelectorAll<HTMLButtonElement>('[data-full]').forEach(button => button.addEventListener('click', () => {
    opener = button;
    big.src = button.dataset.full!;
    big.alt = button.querySelector('img')!.alt;
    dialog.querySelector('p')!.textContent = button.dataset.caption || '';
    dialog.showModal();
  }));
  dialog.querySelector('.close')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', e => { if (e.target === dialog) dialog.close(); });
  dialog.addEventListener('close', () => opener?.focus());
</script>

