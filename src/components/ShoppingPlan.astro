---
import crypto from 'node:crypto';
import { url } from '../lib/urls.mjs';
import { publishedRecipes, readPantry, readCatalog } from '../lib/content.mjs';
import { shoppingList, number } from '../lib/quantities.mjs';
import { formatAmount } from '../lib/format.mjs';

const { plan } = Astro.props;
const pantry = readPantry();
const list = plan ? shoppingList(plan, publishedRecipes(), pantry, readCatalog()) : { rows: [], warnings: [] };
const unit = (u: string, n = 1) => (u && u !== 'piece' ? ' ' + formatAmount({ qty: n, unit: u }).replace(/^\S+ /, '') : '');
const range = (min: number, max: number | null) => `${number(min)}${max != null && max !== min ? '–' + number(max) : ''}`;
const display = (n: number, u: string) => (u === 'g' && n >= 1000 ? [n / 1000, 'kg'] : u === 'ml' && n >= 1000 ? [n / 1000, 'l'] : [n, u]) as [number, string];
function amountText(row: any) {
  if (row.needed == null) return '';
  const [min, u] = display(row.needed, row.unit);
  // Both ends of a range must use the same unit (e.g. 800–1200 g).
  const max = row.neededMax == null ? null : row.neededMax / (u !== row.unit ? 1000 : 1);
  return range(min, max) + unit(u, max ?? min);
}
const toBuy = list.rows.filter(r => r.needed == null || r.neededMax > 0);
const covered = list.rows.filter(r => r.needed != null && r.neededMax === 0);
const groups = [...new Set(toBuy.map(r => r.category))].map(category => ({ category, rows: toBuy.filter(r => r.category === category) }));
// A new plan or a changed list starts with clean ticks.
const key = plan ? `cookbook:shopping:${plan.id}:${crypto.createHash('sha256').update(JSON.stringify(toBuy.map(r => [r.key, r.needed, r.neededMax]))).digest('hex').slice(0, 10)}` : '';
---
<section data-shopping>

  {!plan && <p class="subtitle">Nothing planned yet.</p>}
  {plan && (
    <>
      <p class="subtitle">For {plan.title}{plan.example && ' (example plan)'}. Pantry snapshot: {pantry.updated ?? 'not recorded'}.</p>
      {plan.notes && <p class="notice plan-notes">{plan.notes}</p>}
      {list.warnings.map(w => <p class="notice">{w}</p>)}
      <p><a class="btn primary" href={url(`family/#/collections/plans/entries/${encodeURIComponent(plan.editorSlug)}`)}>Add shopping extras</a> <a class="btn" href={url(`week/?week=${encodeURIComponent(plan.id)}`)}>View meals</a></p>
      <p class="caption">In the family editor, expand “Extra shopping items”. Saved changes appear after publishing, usually in about two minutes. Ticks are saved on this device only.</p>
      {toBuy.length === 0 && <p class="empty">Nothing to buy for this week yet.</p>}
      <div class="actions" hidden data-js>
        <button class="btn" type="button" data-print>Print list</button>
        <button class="btn" type="button" data-reset>Clear ticks</button>
      </div>
      <div data-shopping-list data-key={key}>
        {groups.map(group => (
          <section class="shopping-group">
            <h2>{group.category}</h2>
            <ul class="shopping">
              {group.rows.map(row => (
                <li><label>
                  <input type="checkbox" data-check={row.key}>
                  <span>
                    {row.needed != null && <b>{amountText(row)} </b>}{row.name}{row.optional && ' (optional)'}
                    {row.needed == null && <small>Amount not specified in the recipe; check it.</small>}
                    {row.have > 0 && <small>Pantry covers {number(row.have)}{unit(row.unit, row.have)}.</small>}
                    {row.usuallyStocked && <small>Usually in the cupboard; check before buying.</small>}
                    <small>{row.recipes.join(', ')}{row.notes.length > 0 && ` · ${row.notes.join('; ')}`}</small>
                  </span>
                </label></li>
              ))}
            </ul>
          </section>
        ))}
      </div>
      {covered.length > 0 && (
        <details open><summary>Already have ({covered.length})</summary>
          <ul>{covered.map(row => <li>{row.name}: pantry covers {number(row.have)}{unit(row.unit, row.have)}</li>)}</ul>
        </details>
      )}
      <p class="caption">Only matching ingredients in compatible units are combined; different units stay as separate lines.</p>
    </>
  )}
</section>

<script>
  for (const section of document.querySelectorAll<HTMLElement>('[data-shopping]')) {
    const list = section.querySelector<HTMLElement>('[data-shopping-list]');
    if (!list) continue;
    const key = list.dataset.key!;
    const read = () => { try { return JSON.parse(localStorage.getItem(key) || '{}'); } catch { return {}; } };
    const write = (v: object) => { try { localStorage.setItem(key, JSON.stringify(v)); } catch {} };
    section.querySelectorAll<HTMLElement>('[data-js]').forEach(el => (el.hidden = false));
    const boxes = [...list.querySelectorAll<HTMLInputElement>('[data-check]')];
    const saved = read();
    for (const box of boxes) {
      box.checked = !!saved[box.dataset.check!];
      box.addEventListener('change', () => write({ ...read(), [box.dataset.check!]: box.checked }));
    }
    section.querySelector('[data-reset]')!.addEventListener('click', () => { boxes.forEach(b => (b.checked = false)); write({}); });
    section.querySelector('[data-print]')!.addEventListener('click', () => window.print());
  }
</script>
