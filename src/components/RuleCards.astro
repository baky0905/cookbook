---
// Key rules as icon cards: the first thing to scan on a reference page.
interface Props { rules: { icon: string; title: string; text: string }[] }
const { rules } = Astro.props;
---
<div class="rules">{rules.map(r => <section class="rule"><span class="rule-icon" aria-hidden="true">{r.icon}</span><div><h2>{r.title}</h2><p>{r.text}</p></div></section>)}</div>
