---
import { url } from '../lib/urls.mjs';
// Static redirect for links from the previous site; GitHub Pages has no server-side redirects.
interface Props { to: string; title?: string }
const { to, title = 'Moved' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{title}</title>
  <meta name="robots" content="noindex">
  <meta http-equiv="refresh" content={`0; url=${to}`}>
  <link rel="canonical" href={to}>
  <link rel="icon" href={url('favicon.svg')} type="image/svg+xml">
</head>
<body><p>This page has moved: <a href={to}>{title}</a>.</p></body>
</html>
