{
  "name": "personal-cookbook",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "validate": "node scripts/validate.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run validate && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "recipe:new": "node scripts/new-recipe.mjs",
    "media:optimize": "node scripts/optimize-media.mjs",
    "week:new": "node scripts/new-week.mjs",
    "history:snapshot": "node scripts/snapshot.mjs",
    "recipe:fetch": "node scripts/fetch-recipe.mjs"
  },
  "dependencies": {
    "astro": "7.3.8",
    "marked": "18.1.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "playwright": "^1.56.0",
    "sharp": "0.35.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
